# Copy to .env and fill in the values. .env is git-ignored; never commit real credentials.
# Read by docker compose and, for local runs (IDE / spring-boot:run), by both services via spring.config.import.
# Format: KEY=VALUE, no quotes and no spaces around '='.
#
# Hosts and ports below are what the services use when they run ON THE HOST (IDE / spring-boot:run), and the ports
# docker compose publishes to the host. Inside `docker compose up --build` the services ignore them and use the
# internal addresses (postgres:5432, kafka:19092, redis:6379), set in docker-compose.yml.

# PostgreSQL (triage-service). Use 5433 if a local PostgreSQL already listens on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me

# Kafka (host listener exposed by docker compose)
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis (assistant-service)
REDIS_HOST=localhost
REDIS_PORT=6379

# API keys of the X-API-Key header (required: a service does not start without its key, and docker compose refuses
# to start without them). One key per service; use long random values, e.g. `openssl rand -hex 32`.
# /actuator/health/** is public.
TRIAGE_API_KEY=change-me-triage
ASSISTANT_API_KEY=change-me-assistant

# HTTP ports (also the host ports published by docker compose; inside the containers they are 8080 and 8081)
TRIAGE_SERVER_PORT=8080
ASSISTANT_SERVER_PORT=8081

# LLM provider. Keep this line commented out to run without a key: the assistant starts
# and LLM calls fail (503 via circuit breaker). An EMPTY value (OPENAI_API_KEY=) breaks startup when the service
# runs on the host; docker compose turns an empty value into the placeholder.
# OPENAI_API_KEY=
