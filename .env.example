# Copy to .env and fill in the values. .env is git-ignored; never commit real credentials.
# Read by docker compose and, for local runs (IDE / spring-boot:run), by both services via spring.config.import.
# Format: KEY=VALUE, no quotes and no spaces around '='.

# PostgreSQL (triage-service). Use 5433 if a local PostgreSQL already listens on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me

# Kafka (host listener exposed by docker compose)
KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis (assistant-service)
REDIS_HOST=localhost
REDIS_PORT=6379

# HTTP ports
TRIAGE_SERVER_PORT=8080
ASSISTANT_SERVER_PORT=8081

# LLM provider. Keep this line commented out to run without a key: the assistant starts
# and LLM calls fail (503 via circuit breaker). An EMPTY value (OPENAI_API_KEY=) breaks startup.
# OPENAI_API_KEY=
